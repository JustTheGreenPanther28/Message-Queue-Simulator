# Production secrets for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and fill in.
# Generate each secret with:  openssl rand -base64 36
JWT_SECRET=
DB_PASSWORD=
RABBIT_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The URL people open in the browser (used for CORS and WebSocket origin checks).
PUBLIC_ORIGIN=https://chat.example.com
# How browsers reach object storage:
#   /storage                      -> self-hosted storage proxied by nginx (default, no CORS)
#   https://bucket.s3.amazonaws.com -> direct mode; also set S3_PUBLIC_ORIGIN to the same
#                                      origin (CSP) and add a bucket CORS rule for PUBLIC_ORIGIN
S3_PUBLIC_ENDPOINT=/storage
S3_PUBLIC_ORIGIN=
WEB_PORT=3000
