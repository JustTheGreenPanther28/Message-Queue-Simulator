# Serves the SPA and forwards API and WebSocket traffic to the API gateway.
# Environment variables (${...}) are filled in at container start by the nginx image.
# Images are served same-origin under /storage/ (proxy mode). ${S3_PUBLIC_ORIGIN} is only needed
# in direct mode (browser talks to e.g. an S3 bucket URL); it's empty otherwise.
server {
    listen 80;
    server_tokens off;
    client_max_body_size 1m;   # images go straight to object storage, not through here

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers. Defined once here and never overridden with add_header in a location
    # (that would silently drop all of these for that location).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: ${S3_PUBLIC_ORIGIN}; connect-src 'self' ${S3_PUBLIC_ORIGIN}; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # no-referrer: presigned image URLs must never leak to other sites via the Referer header.
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # Behind HTTPS, also send: Strict-Transport-Security "max-age=31536000; includeSubDomains"

    root /usr/share/nginx/html;

    location / {
        try_files $uri /index.html;
        expires -1;              # index.html: always revalidate, so deploys take effect
    }

    location /assets/ {
        expires 1y;              # hashed file names: cache forever
    }

    # Object storage, same-origin. Every request is authorised by its presigned signature,
    # which was computed for the internal storage host, so that Host is passed through as-is.
    location /storage/ {
        resolver ${DNS_RESOLVER} valid=10s;
        set $storage_upstream ${STORAGE_UPSTREAM};
        rewrite ^/storage/(.*)$ /$1 break;
        proxy_pass $storage_upstream;
        proxy_set_header Host ${STORAGE_HOST};
        proxy_set_header Authorization "";   # only presigned URLs, never header credentials
        client_max_body_size 11m;            # images are capped at 10 MB by the signature anyway
        proxy_request_buffering off;
    }

    location /api/ {
        proxy_pass http://api-gateway:8080;
        proxy_set_header Host $host;
        # Overwrite (don't append) so clients can't spoof their IP for the rate limiter.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(ws|ws-notifications)$ {
        proxy_pass http://api-gateway:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 1h;
    }

    # Nothing else is served: no actuator, no dotfiles.
    location ~ /\. { deny all; }
}
